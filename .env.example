# Configuración de Entorno - Peluquería & Barbería Web
# NUNCA ingresar contraseñas reales ni secretos en este archivo de plantilla

# Entorno de ejecución
NODE_ENV=production
PORT=3000

# Contraseña de acceso al Panel Administrativo
# En producción, configurar una contraseña robusta de al menos 16 caracteres
ADMIN_PASSWORD=cambiar_por_contrasena_segura_de_produccion

# Zona Horaria Oficial
TZ=America/Argentina/Buenos_Aires
